---
import { render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import DetailLayout from '../../layouts/DetailLayout.astro';
import ServiceDetail from '../../components/details/ServiceDetail.astro';
import { categoryLabels } from '../../data/labels';
import { getPublishedContent } from '../../utils/content';
import { consultationLink } from '../../utils/whatsapp';
export const getStaticPaths = (async () => {
  const { services, projects } = await getPublishedContent();
  return services.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, relatedProjects: projects.filter((project) => entry.data.relatedProjectIds.some((ref) => ref.id === project.id)).slice(0, 3) },
  }));
}) satisfies GetStaticPaths;
interface Props { entry: CollectionEntry<'services'>; relatedProjects: CollectionEntry<'projects'>[]; }
const { entry, relatedProjects } = Astro.props;
const { Content, headings } = await render(entry);
if (headings.some((heading) => heading.depth === 1)) {
  throw new Error(`Body layanan tidak boleh menambahkan H1: ${entry.id}`);
}
const seoCover = entry.data.coverImage?.permissionConfirmed ? entry.data.coverImage : undefined;
---
<DetailLayout consultationHref={consultationLink('layanan', entry.data.slug)} seoImage={seoCover?.src} seoImageAlt={seoCover?.alt} title={entry.data.title} description={entry.data.summary} eyebrow={categoryLabels[entry.data.category]} breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Layanan', href: '/layanan' }, { label: entry.data.title }]}>
  <ServiceDetail entry={entry} relatedProjects={relatedProjects}><Content /></ServiceDetail>
</DetailLayout>
