---
import { pages } from '../data/pages';
import { verifiedWhatsappNumber } from '../data/site';
import { consultationLink } from '../utils/whatsapp';
interface Props { kind?: 'layanan' | 'properti' | 'proyek'; slug?: string; demo?: boolean; }
const { kind, slug, demo = false } = Astro.props;
const preview = import.meta.env.DEV && demo;
const href = kind && slug ? consultationLink(kind, slug, preview) : pages.detail.contactHref;
const label = verifiedWhatsappNumber ? kind === 'properti' ? 'Jadwalkan Survei' : kind === 'layanan' ? 'Minta Penawaran' : 'Konsultasikan Kebutuhan' : pages.detail.contactActionLabel;
---
<div class="contact-notice"><p>{verifiedWhatsappNumber ? 'Susun kebutuhan Anda di halaman kontak, lalu tinjau pesan sebelum membuka WhatsApp.' : pages.detail.contactNotice}</p><a class="button button--secondary" href={href}>{label} <span aria-hidden="true">↗</span></a></div>
<style>.contact-notice { margin-top: var(--space-6); padding-top: var(--space-6); border-top: 1px solid var(--color-border); } p { color: var(--color-muted); font-size: var(--text-caption); } .button { width: 100%; }</style>
