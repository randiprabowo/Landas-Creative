---
interface Props { id: string; eyebrow: string; title: string; description?: string; }
const { id, eyebrow, title, description } = Astro.props;
---
<div class="section-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {description && <p class="muted section-description">{description}</p>}
</div>
<style>
  .section-heading { max-width: 46rem; margin-bottom: var(--space-8); }
  .eyebrow { margin-bottom: var(--space-3); }
  h2 { max-width: 25ch; margin-bottom: var(--space-4); }
  .section-description { margin-bottom: 0; }
  @media (min-width: 1024px) { .section-heading { margin-bottom: var(--space-12); } }
</style>
