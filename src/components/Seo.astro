---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, verifiedWhatsappNumber } from '../data/site';
import { resolveAsset } from '../utils/assets';
import { canonicalUrl, serializeJsonLd } from '../utils/seo';
interface Props { title: string; description: string; noindex?: boolean; image?: ImageMetadata; imageAlt?: string; }
const { title, description, noindex = false, image, imageAlt = 'Logo LNDS — Landas Creative, Foundations & Growth' } = Astro.props;
const canonical = canonicalUrl(site, Astro.url.pathname, noindex);
const blocked = !site.indexingEnabled || noindex || !canonical;
const source = image ?? resolveAsset(site.logo);
const socialImage = canonical && source ? await getImage({ src: source, width: Math.min(1200, source.width), format: 'jpg' }) : null;
const socialUrl = socialImage && site.siteUrl ? new URL(socialImage.src, site.siteUrl).href : undefined;
const organization = canonical && Astro.url.pathname === '/' ? {
  '@context': 'https://schema.org', '@type': 'Organization', name: site.brandName, slogan: site.tagline,
  url: canonical, ...(socialUrl ? { logo: socialUrl } : {}),
  ...(verifiedWhatsappNumber ? { telephone: `+${verifiedWhatsappNumber}` } : {}),
  ...(site.email ? { email: site.email } : {}),
  ...(site.socialLinks.length ? { sameAs: site.socialLinks.map((link) => link.url) } : {}),
} : null;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={blocked ? 'noindex, nofollow' : 'index, follow'} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="id_ID" />
<meta property="og:site_name" content={site.brandName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{socialUrl && <><meta property="og:image" content={socialUrl} /><meta property="og:image:alt" content={imageAlt} /><meta property="og:image:width" content={socialImage?.attributes.width} /><meta property="og:image:height" content={socialImage?.attributes.height} /></>}
<meta name="twitter:card" content={socialUrl ? 'summary_large_image' : 'summary'} />
{organization && <script type="application/ld+json" set:html={serializeJsonLd(organization)} />}
