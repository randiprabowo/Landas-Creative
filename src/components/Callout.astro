---
interface Props {
  id: string; eyebrow: string; title: string; description: string;
  actionLabel: string; href: string; notice?: string; tone?: 'soft' | 'dark';
}
const { id, eyebrow, title, description, actionLabel, href, notice, tone = 'soft' } = Astro.props;
---
<section class:list={['callout', `callout--${tone}`, 'section']} id={id} aria-labelledby={`${id}-heading`}>
  <div class="container callout-grid">
    <div><p class="eyebrow">{eyebrow}</p><h2 id={`${id}-heading`}>{title}</h2></div>
    <div class="callout-body"><p>{description}</p>{notice && <p class="callout-notice">{notice}</p>}<a class:list={['button', { 'button--secondary': tone === 'soft' }]} href={href}>{actionLabel} <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
<style>
  .callout--soft { background: var(--color-surface-soft); }
  .callout--dark { background: var(--color-ink); color: var(--color-canvas); --color-focus: var(--color-canvas); }
  .callout-grid { display: grid; gap: var(--space-6); }
  .eyebrow { margin-bottom: var(--space-4); }
  h2 { max-width: 23ch; margin-bottom: 0; }
  .callout-body > p { margin-bottom: var(--space-6); }
  .callout-notice { color: var(--color-muted); font-size: var(--text-caption); }
  .button { margin-top: var(--space-2); }
  .callout--dark .eyebrow, .callout--dark .callout-notice { color: var(--color-canvas); }
  .callout--dark .button { background: var(--color-canvas); color: var(--color-ink); }
  .callout--dark .button:hover { background: var(--color-surface); }
  @media (min-width: 768px) { .callout-grid { grid-template-columns: 1.1fr 1fr; gap: var(--space-12); align-items: center; } }
</style>
