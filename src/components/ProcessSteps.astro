---
interface Props { steps: { title: string; description: string }[]; }
const { steps } = Astro.props;
---
<ol class="process-steps">
  {steps.map((step, index) => <li><span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}
</ol>
<style>
  .process-steps { display: grid; gap: var(--space-8); list-style: none; padding: 0; margin: 0; }
  li { display: grid; grid-template-columns: 48px minmax(0, 1fr); align-items: start; gap: var(--space-4); }
  .step-number { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--color-control-border); border-radius: 50%; background: var(--color-canvas); color: var(--color-brand); font-size: var(--text-caption); font-weight: 600; }
  h3 { font-size: 1.125rem; margin-block: var(--space-2) var(--space-3); }
  p { margin-bottom: 0; color: var(--color-muted); font-size: var(--text-caption); }
  @media (min-width: 768px) { .process-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .process-steps { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-6); }
    li { display: block; position: relative; }
    li:not(:last-child)::after { content: ''; position: absolute; top: 24px; left: 64px; right: 0; height: 1px; background: var(--color-border); }
    h3 { margin-top: var(--space-6); }
  }
</style>
