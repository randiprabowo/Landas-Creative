---
import { site } from '../data/site';
import { mainNavigation } from '../data/navigation';
const active = (href: string) => href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <!-- Nama perusahaan sebagai teks, bukan penggambaran ulang logo LNDS. -->
    <a class="brand" href="/">
      <span class="brand-name">{site.brandName}</span>{' '}
      <span class="brand-tagline">{site.tagline}</span>
      <span class="sr-only"> — Beranda</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle hidden>
      <span data-menu-label>Menu</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <nav id="primary-navigation" class="primary-navigation" aria-label="Navigasi utama">
      <ul>
        {mainNavigation.map((item) => <li><a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
      </ul>
      <a class="button header-cta" href="/kontak">Konsultasi <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navigation = header?.querySelector<HTMLElement>('#primary-navigation');
  const label = toggle?.querySelector<HTMLElement>('[data-menu-label]');

  if (header && toggle && navigation && label) {
    const desktop = window.matchMedia('(min-width: 1024px)');
    let open = false;

    function syncMenu() {
      if (!toggle || !navigation || !label) return;
      toggle.hidden = desktop.matches;
      navigation.hidden = !desktop.matches && !open;
      toggle.setAttribute('aria-expanded', String(!desktop.matches && open));
      label.textContent = open ? 'Tutup menu' : 'Menu';
    }

    toggle.addEventListener('click', () => { open = !open; syncMenu(); });
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) {
        open = false;
        syncMenu();
        toggle.focus();
      }
    });
    navigation.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a') && !desktop.matches) {
        open = false;
        // Kembalikan fokus sebelum panel disembunyikan.
        toggle.focus();
        syncMenu();
      }
    });
    desktop.addEventListener('change', () => {
      open = false;
      if (!desktop.matches && navigation.contains(document.activeElement)) toggle.focus();
      syncMenu();
    });
    syncMenu();
  }
</script>

<style>
  .site-header { border-bottom: 1px solid var(--color-border); background: var(--color-canvas); }
  .header-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; column-gap: var(--space-4); min-height: 72px; }
  .brand { display: grid; padding-block: var(--space-3); color: var(--color-ink); text-decoration: none; }
  .brand-name { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1.4; }
  .brand-tagline { font-size: 0.75rem; color: var(--color-muted); }
  .menu-toggle { display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3); color: var(--color-ink); background: transparent; border: 1px solid var(--color-control-border); border-radius: var(--radius-control); }
  .primary-navigation { flex-basis: 100%; padding-block: var(--space-4) var(--space-6); }
  .primary-navigation ul { display: grid; list-style: none; margin: 0 0 var(--space-4); padding: 0; }
  .primary-navigation li a { display: flex; align-items: center; min-height: 48px; color: var(--color-ink); text-decoration: none; font-size: var(--text-caption); font-weight: 600; }
  .primary-navigation li a:hover { color: var(--color-brand); text-decoration: underline; }
  .primary-navigation li a[aria-current] { color: var(--color-brand); text-decoration: underline; text-decoration-thickness: 2px; }
  .header-cta { width: 100%; }
  @media (min-width: 1024px) {
    .header-inner { min-height: 80px; flex-wrap: nowrap; }
    .primary-navigation { display: flex; align-items: center; gap: var(--space-6); flex-basis: auto; padding: 0; }
    .primary-navigation ul { display: flex; align-items: center; gap: var(--space-4); margin: 0; }
    .header-cta { width: auto; padding-inline: var(--space-4); font-size: var(--text-caption); }
  }
</style>
