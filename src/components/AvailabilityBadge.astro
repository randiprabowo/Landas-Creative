---
import { availabilityLabels } from '../data/labels';
interface Props { status: keyof typeof availabilityLabels; }
const { status } = Astro.props;
---
<span class:list={['availability', `availability--${status}`]}>{availabilityLabels[status]}</span>
<style>
  .availability { display: inline-block; padding: var(--space-1) var(--space-3); border-radius: var(--radius-control); background: var(--color-surface-soft); color: var(--color-success); font-size: var(--text-caption); font-weight: 600; }
  .availability--dipesan { color: var(--color-warning); background: var(--color-canvas); }
  .availability--terjual { color: var(--color-muted); background: var(--color-canvas); }
</style>
