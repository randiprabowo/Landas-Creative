---
import type { BreadcrumbItem } from '../data/navigation';
import { site } from '../data/site';
import { canonicalUrl, serializeJsonLd } from '../utils/seo';
interface Props { items: BreadcrumbItem[]; }
const { items } = Astro.props;
const current = canonicalUrl(site, Astro.url.pathname);
const schema = current ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.label, item: item.href ? canonicalUrl(site, item.href) : current })) } : null;
---
<nav class="breadcrumb" aria-label="Jejak halaman">
  <ol>{items.map((item, index) => <li>{index > 0 && <span class="separator" aria-hidden="true">/</span>}{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}</ol>
</nav>
{schema && <script type="application/ld+json" set:html={serializeJsonLd(schema)} />}
<style>
  ol { display: flex; align-items: center; flex-wrap: wrap; gap: 0 var(--space-3); list-style: none; margin: 0; padding: 0; font-size: var(--text-caption); line-height: 1.5; }
  li { display: inline-flex; align-items: center; gap: var(--space-3); min-height: 44px; min-width: 0; max-width: 100%; }
  a { display: inline-flex; align-items: center; min-height: 44px; }
  .separator, [aria-current] { color: var(--color-muted); }
</style>
